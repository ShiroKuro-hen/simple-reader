{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "mimeType": "application/epub+zip",
        "description": "EPUB book"
      },
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "description": "PDF document"
      },
      {
        "ext": [
          "cbz"
        ],
        "mimeType": "application/vnd.comicbook+zip",
        "description": "Comic book (ZIP)"
      },
      {
        "ext": [
          "cbr"
        ],
        "mimeType": "application/vnd.comicbook-rar",
        "description": "Comic book (RAR)"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RUM4Mjc5M0IyMDBCQ0YKUldUUEN5QTdlWUxzQkViL0h4TkFZZXdwbnhTUkpzbXl1TytqaEtpY2x2b2pHVm9zdlQ1RXFyZXcK",
      "endpoints": [
        "https://github.com/ShiroKuro-hen/simple-reader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
